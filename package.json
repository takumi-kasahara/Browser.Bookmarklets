{
  "type": "module",
  "scripts": {
    "build": "npm run lint && npm run build:minify && npm run build:page",
    "build:minify": "node --experimental-strip-types .tools/build.minify.ts",
    "build:page": "node --experimental-strip-types .tools/build.page.ts",
    "lint": "prettier --write . && markdownlint-cli2 --fix . && eslint --fix .",
    "test": "tsc && vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.68.0",
    "@html-eslint/parser": "^0.68.0",
    "@types/jsdom": "^30.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "private": true
}
