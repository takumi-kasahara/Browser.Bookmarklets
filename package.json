{
  "type": "module",
  "scripts": {
    "build": "npm run build:minify && npm run build:page && npm run lint",
    "build:minify": "node --experimental-strip-types .tools/build.minify.ts",
    "build:page": "node --experimental-strip-types .tools/build.page.ts",
    "lint": "prettier --write . && markdownlint-cli2 --fix . && eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.67.0",
    "@html-eslint/parser": "^0.67.0",
    "@types/node": "^26.6.5",
    "@types/web": "^0.0.359",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  },
  "private": true
}
